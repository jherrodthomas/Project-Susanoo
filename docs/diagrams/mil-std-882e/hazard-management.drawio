ification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#204B70;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="65" width="257" height="52" as="geometry"/></mxCell><mxCell id="10" value="Verify implementation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#87A3BD;" vertex="1" parent="1"><mxGeometry x="572" y="142" width="233" height="76" as="geometry"/></mxCell><mxCell id="11" value="Validate risk reduction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#87A3BD;" vertex="1" parent="1"><mxGeometry x="572" y="252" width="233" height="76" as="geometry"/></mxCell><mxCell id="12" value="Risk authority" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#204B70;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="825" y="65" width="257" height="52" as="geometry"/></mxCell><mxCell id="13" value="Review residual risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#87A3BD;" vertex="1" parent="1"><mxGeometry x="837" y="142" width="233" height="76" as="geometry"/></mxCell><mxCell id="14" value="Accept / reject / return" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#87A3BD;" vertex="1" parent="1"><mxGeometry x="837" y="252" width="233" height="76" as="geometry"/></mxCell><mxCell id="15" value="Residual risk acceptance is a separate authorized decision, never automatic closure." style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="1050" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>