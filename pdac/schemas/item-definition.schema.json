{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "susanoo/item-definition/v0.1",
  "title": "Item definition: functions, elements, external elements and interfaces",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "revision", "status", "configuration", "scope", "functions", "elements", "externals", "interfaces"],
  "properties": {
    "schema": {"const": "susanoo/item-definition/v0.1"},
    "id": {"type": "string"},
    "title": {"type": "string"},
    "revision": {"type": "string"},
    "status": {"enum": ["draft", "in-review", "approved"]},
    "configuration": {"type": "string"},
    "scope": {"type": "string"},
    "functions": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "performed_by"],
      "properties": {
        "id": {"type": "string", "pattern": "^F-[0-9]{2}$"},
        "name": {"type": "string"},
        "performed_by": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "modes": {"type": "array", "items": {"type": "string", "pattern": "^MOD-[0-9]{2}$"}},
        "scenarios": {"type": "array", "items": {"type": "string", "pattern": "^SCN-[0-9]{3}$"}}
      }}},
    "elements": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "parent", "name", "kind", "safety_role", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^SUS-[A-Z0-9]+(-[A-Z0-9]+)*$"},
        "parent": {"type": "string"},
        "name": {"type": "string"},
        "kind": {"enum": ["system", "mechanical", "electrical", "computing", "human-interface", "mixed"]},
        "safety_role": {"enum": ["protective", "none"]},
        "status": {"enum": ["concept", "candidate", "baselined"]},
        "decision": {"type": "string", "pattern": "^DQ-[0-9]{3}$"},
        "source": {"type": "string"}
      }}},
    "externals": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "name", "assumption"],
      "properties": {
        "id": {"type": "string", "pattern": "^EXT-[A-Z0-9-]+$"},
        "name": {"type": "string"},
        "assumption": {"type": "string"}
      }}},
    "interfaces": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "from", "to", "direction", "kind", "exchange", "hazard_ids", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^IF-(PX4-)?[0-9]{3}$"},
        "name": {"type": "string"},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "direction": {"enum": ["uni", "bi"]},
        "kind": {"type": "array", "minItems": 1, "items": {"enum": ["data", "energy", "mechanical", "human", "environment"]}},
        "exchange": {"type": "string"},
        "hazard_ids": {"type": "array", "items": {"type": "string"}},
        "source": {"type": "string"},
        "status": {"enum": ["candidate"]},
        "decision": {"type": "string", "pattern": "^DQ-[0-9]{3}$"}
      }}}
  }
}
