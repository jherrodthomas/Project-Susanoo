{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "susanoo/decision-register/v0.1",
  "title": "Decision register: questions for the project lead",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decisions"],
  "properties": {
    "schema": {"const": "susanoo/decision-register/v0.1"},
    "decisions": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "question", "context", "options", "recommendation", "reversibility", "decider", "status", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^DQ-[0-9]{3}$"},
        "question": {"type": "string", "minLength": 10},
        "context": {"type": "string", "minLength": 20},
        "options": {"type": "array", "minItems": 2, "maxItems": 4, "items": {
          "type": "object", "additionalProperties": false, "required": ["key", "title", "detail"],
          "properties": {"key": {"type": "string"}, "title": {"type": "string"}, "detail": {"type": "string"}}}},
        "recommendation": {"type": "string"},
        "reversibility": {"enum": ["easy", "revisit", "hard"]},
        "blocks": {"type": "array", "items": {"type": "string"}},
        "gate": {"type": "string"},
        "decider": {"enum": ["lead", "claude"]},
        "status": {"enum": ["queued", "open", "answered", "applied", "withdrawn"]},
        "asked": {"type": ["string", "null"], "format": "date"},
        "answer": {"type": ["object", "null"], "additionalProperties": false, "required": ["choice", "by", "at", "via"],
          "properties": {
            "choice": {"type": "string"}, "by": {"type": "string"}, "at": {"type": "string", "format": "date"},
            "via": {"enum": ["chat", "inbox", "review", "pull-request"]}, "note": {"type": "string"}}},
        "applied_in": {"type": "array", "items": {"type": "string"}},
        "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }}}
  }
}
