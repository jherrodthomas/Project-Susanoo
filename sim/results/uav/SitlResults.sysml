        first isKeepoutBreach then isLandedAtStaleHome;
        first isLandedAtStaleHome then isGeofenceOvershoot;
        first isGeofenceOvershoot then isLandedClear;
        first isLandedClear then isContained;
        first isContained then isAirborneAtHorizon;
        first isAirborneAtHorizon then done;
    }
}
